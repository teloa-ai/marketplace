   {"name": "get_projects", "description": {"zh-CN": "列出可访问的项目", "en": "List accessible projects"}, "readOnly": true}
  ],
  "upstreamUrl": "https://docs.sentry.io/product/sentry-basics/integrations/mcp/"
 },
