{
  "format": "teloa.market-catalog-entry/v1",
  "id": "teloa.mcp-dingtalk",
  "kind": "connector",
  "delivery": "managed",
  "version": "1.0.1",
  "taxonomy": {
    "functions": [
      "communication"
    ],
    "industries": [
