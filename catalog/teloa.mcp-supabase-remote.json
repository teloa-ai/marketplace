{
  "format": "teloa.market-catalog-entry/v1",
  "id": "teloa.mcp-supabase-remote",
  "kind": "connector",
  "delivery": "managed",
  "version": "1.0.0",
  "taxonomy": {
    "functions": [
      "dev-tools",
      "cloud-ops"
    ],
    "industries": [
      "general"
    ]
  },
  "upstream": null,
  "connector": {
    "serverName": "supabase_remote",
    "title": {
      "zh-CN": "Supabase 远程（OAuth）",
      "en": "Supabase Remote (OAuth)"
    },
    "summary": {
      "zh-CN": "Supabase 官方托管远程 MCP 服务，可查看项目与数据表、执行 SQL、查看日志与安全建议、管理边缘函数。由宿主以 OAuth（动态客户端注册 + PKCE）授权，令牌自动刷新，不需要填写访问令牌。",
      "en": "Supabase's official hosted remote MCP service for browsing projects and tables, running SQL, reading logs and advisors, and managing Edge Functions. Authorized by the host via OAuth (dynamic client registration + PKCE) with automatic token refresh; no access token needs to be entered."
    },
    "auth": {
      "kind": "oauth",
      "supported": true,
      "scopes": []
    },
    "recipe": {
      "transport": "streamable-http",
      "url": "https://mcp.supabase.com/mcp"
    },
    "tools": [
      {
        "name": "list_organizations",
        "description": {
          "zh-CN": "列出组织",
          "en": "List organizations"
        },
        "readOnly": true
      },
      {
        "name": "list_projects",
        "description": {
          "zh-CN": "列出项目",
          "en": "List projects"
        },
        "readOnly": true
      },
      {
        "name": "get_project",
        "description": {
          "zh-CN": "获取项目详情",
          "en": "Get project details"
        },
        "readOnly": true
      },
      {
        "name": "get_project_url",
        "description": {
          "zh-CN": "获取项目 API 地址",
          "en": "Get project API URL"
        },
        "readOnly": true
      },
      {
        "name": "list_tables",
        "description": {
          "zh-CN": "列出数据表",
          "en": "List tables"
        },
        "readOnly": true
      },
      {
        "name": "list_extensions",
        "description": {
          "zh-CN": "列出数据库扩展",
          "en": "List database extensions"
        },
        "readOnly": true
      },
      {
        "name": "list_migrations",
        "description": {
          "zh-CN": "列出迁移",
          "en": "List migrations"
        },
        "readOnly": true
      },
      {
        "name": "apply_migration",
        "description": {
          "zh-CN": "应用数据库迁移",
          "en": "Apply a database migration"
        },
        "readOnly": false
      },
      {
        "name": "execute_sql",
        "description": {
          "zh-CN": "执行 SQL",
          "en": "Execute SQL"
        },
        "readOnly": false
      },
      {
        "name": "query_logs",
        "description": {
          "zh-CN": "查询日志",
          "en": "Query logs"
        },
        "readOnly": true
      },
      {
        "name": "get_advisors",
        "description": {
          "zh-CN": "获取安全与性能建议",
          "en": "Get security and performance advisors"
        },
        "readOnly": true
      },
      {
        "name": "generate_typescript_types",
        "description": {
          "zh-CN": "生成 TypeScript 类型",
          "en": "Generate TypeScript types"
        },
        "readOnly": true
      },
      {
        "name": "list_edge_functions",
        "description": {
          "zh-CN": "列出边缘函数",
          "en": "List Edge Functions"
        },
        "readOnly": true
      },
      {
        "name": "get_edge_function",
        "description": {
          "zh-CN": "获取边缘函数",
          "en": "Get an Edge Function"
        },
        "readOnly": true
      },
      {
        "name": "deploy_edge_function",
        "description": {
          "zh-CN": "部署边缘函数",
          "en": "Deploy an Edge Function"
        },
        "readOnly": false
      },
      {
        "name": "list_branches",
        "description": {
          "zh-CN": "列出开发分支",
          "en": "List development branches"
        },
        "readOnly": true
      },
      {
        "name": "list_storage_buckets",
        "description": {
          "zh-CN": "列出存储桶",
          "en": "List storage buckets"
        },
        "readOnly": true
      },
      {
        "name": "search_docs",
        "description": {
          "zh-CN": "搜索 Supabase 文档",
          "en": "Search Supabase docs"
        },
        "readOnly": true
      }
    ],
    "upstreamUrl": "https://supabase.com/docs/guides/getting-started/mcp"
  },
  "modifications": [],
  "license": {
    "spdx": "LicenseRef-Supabase-Terms",
    "files": [
      "LICENSE"
    ]
  },
  "compatibility": {
    "status": "needs-configuration",
    "teloa": ">=0.2.0-alpha.6",
    "dsh": "0.1.7-rc.1",
    "conditions": [
      {
        "zh-CN": "需在 市场 → 连接 页由本人在浏览器中完成 OAuth 授权；服务器部署需在配置文件设置 oauth.publicCallbackUrl",
        "en": "The owner must complete OAuth authorization in a browser from Market → Connections; server deployments must set oauth.publicCallbackUrl in the config file"
      },
      {
        "zh-CN": "官方文档确认托管服务默认使用动态客户端注册；本机回环回调（127.0.0.1）尚未实测",
        "en": "Official docs confirm the hosted server uses dynamic client registration by default; the loopback callback (127.0.0.1) has not been tested yet"
      },
      {
        "zh-CN": "官方未列出 scope 名称（现阶段需授予全部权限）：授权请求不指定 scope，由 Supabase 按默认授予",
        "en": "The official docs do not list scope names (all scopes are currently required): the authorization request specifies no scope and Supabase grants its default"
      },
      {
        "zh-CN": "建议只连接非生产项目；写操作（执行 SQL、迁移、部署函数）按岗位审批执行",
        "en": "Prefer non-production projects; write tools (SQL, migrations, function deploys) run under role approval"
      }
    ]
  },
  "requires": {
    "tools": [],
    "network": true,
