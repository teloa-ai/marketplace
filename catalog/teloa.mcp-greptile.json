{
  "format": "teloa.market-catalog-entry/v1",
  "id": "teloa.mcp-greptile",
  "kind": "connector",
  "delivery": "managed",
  "version": "1.0.0",
  "taxonomy": {
    "functions": [
      "dev-tools"
    ],
    "industries": [
      "general"
    ]
  },
  "upstream": null,
  "connector": {
    "serverName": "greptile",
    "title": {
      "zh-CN": "Greptile（代码库语义搜索）",
      "en": "Greptile (Codebase Semantic Search)"
    },
    "summary": {
      "zh-CN": "Greptile 官方远程 MCP，通过 API Key 查看已索引的仓库、合并请求与 Greptile 代码评审意见。需在 Greptile 平台接入目标仓库。数据经由 greptile.com 传输。",
      "en": "Greptile official remote MCP: with an API key, browse indexed repositories, pull/merge requests and Greptile code-review comments. Target repositories must be connected in Greptile. Data transits greptile.com."
    },
    "auth": {
      "kind": "secret",
      "vars": [
        {
          "target": "bearer",
          "label": {
            "zh-CN": "Greptile API Key（在 greptile.com 账户中获取）",
            "en": "Greptile API Key (obtain from greptile.com account)"
          },
          "required": true
        }
      ]
    },
    "recipe": {
      "transport": "streamable-http",
      "url": "https://api.greptile.com/mcp"
    },
    "tools": [
      {
        "name": "list_repositories",
        "description": {
          "zh-CN": "列出 Greptile 已接入的仓库",
          "en": "List repositories connected to Greptile"
        },
        "readOnly": true
      },
      {
        "name": "list_pull_requests",
        "description": {
          "zh-CN": "列出 Pull Request",
          "en": "List pull requests"
        },
        "readOnly": true
      },
      {
        "name": "get_merge_request",
        "description": {
          "zh-CN": "获取 PR / MR 详情与评审记录",
          "en": "Get a PR/MR with review records"
        },
        "readOnly": true
      },
      {
        "name": "list_merge_request_comments",
        "description": {
          "zh-CN": "列出 PR / MR 评审意见",
          "en": "List PR/MR review comments"
        },
        "readOnly": true
      },
      {
        "name": "search_greptile_comments",
        "description": {
          "zh-CN": "搜索 Greptile 评审意见",
          "en": "Search Greptile review comments"
        },
        "readOnly": true
      }
    ],
    "upstreamUrl": "https://docs.greptile.com/integrations/mcp"
  },
  "modifications": [],
  "license": {
    "spdx": "LicenseRef-Greptile-Terms",
    "files": [
      "LICENSE"
    ]
  },
  "compatibility": {
    "status": "needs-configuration",
    "teloa": ">=0.2.0-alpha.6",
    "dsh": "0.1.7-rc.1",
    "conditions": [
      {
        "zh-CN": "数据经由 greptile.com 平台传输",
        "en": "Data passes through greptile.com"
      }
    ]
  },
  "requires": {
    "tools": [],
    "network": true,
    "runtimes": []
  },
  "review": {
    "status": "approved",
    "reviewedAt": "2026-09-25",
    "reviewer": "Teloa"
  }
}
