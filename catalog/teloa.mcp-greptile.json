    "teloa": ">=0.2.0-alpha.6",
    "dsh": "0.1.7-rc.1",
    "conditions": [
      {
        "zh-CN": "数据经由 greptile.com 平台传输",
        "en": "Data passes through greptile.com"
      }
    ]
  },
