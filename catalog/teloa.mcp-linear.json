{
  "format": "teloa.market-catalog-entry/v1",
  "id": "teloa.mcp-linear",
  "kind": "connector",
  "delivery": "managed",
  "version": "1.0.0",
  "taxonomy": {
    "functions": [
      "communication"
    ],
    "industries": [
      "general"
    ]
  },
  "upstream": null,
  "connector": {
    "serverName": "linear",
    "title": {
      "zh-CN": "Linear（官方远程 MCP）",
      "en": "Linear (Official Remote MCP)"
    },
    "summary": {
      "zh-CN": "Linear 官方远程 MCP 服务，提供 Issue 搜索、查看、创建、更新与项目列表能力。需要 Linear API Key（Bearer Token）。",
      "en": "Linear's official remote MCP service providing issue search, view, create, update, and project listing. Requires Linear API Key (Bearer Token)."
    },
    "auth": {
      "kind": "secret",
      "vars": [
        {
          "target": "bearer",
          "label": {
            "zh-CN": "Linear API Key（从 Linear 设置 → API 获取）",
            "en": "Linear API Key (get from Linear Settings → API)"
          },
          "required": true
        }
      ]
    },
    "recipe": {
      "transport": "streamable-http",
      "url": "https://mcp.linear.app/mcp"
    },
    "tools": [
      {
        "name": "search_issues",
        "description": {
          "zh-CN": "搜索 Linear Issue",
          "en": "Search Linear issues"
        },
        "readOnly": true
      },
      {
        "name": "get_issue",
        "description": {
          "zh-CN": "获取指定 Issue 详情",
          "en": "Get details for a specified issue"
        },
        "readOnly": true
      },
      {
        "name": "create_issue",
        "description": {
          "zh-CN": "创建新 Issue",
          "en": "Create a new issue"
        },
        "readOnly": false
      },
      {
        "name": "update_issue",
        "description": {
          "zh-CN": "更新 Issue 状态或属性",
          "en": "Update issue status or attributes"
        },
        "readOnly": false
      },
      {
        "name": "list_projects",
        "description": {
          "zh-CN": "列出项目",
          "en": "List projects"
        },
        "readOnly": true
      }
    ],
    "upstreamUrl": "https://linear.app/settings/api"
  },
